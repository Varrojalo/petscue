# Copia este archivo como .env y completa los valores.

# Django
# Genera una clave larga y aleatoria. Nunca la compartas ni la subas al repositorio.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=true
# Dominios desde los que se puede acceder, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Santiago

# PostgreSQL
POSTGRES_DB=petscue
POSTGRES_USER=petscue
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Correo (cada fundación usa el suyo; la guía de instalación explica opciones gratuitas)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
